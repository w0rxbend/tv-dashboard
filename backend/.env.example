# Server
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Location — used by all time-aware endpoints and Open-Meteo API calls.
# Defaults to Kyiv, Ukraine if unset.
LOCATION_CITY=Kyiv
LOCATION_REGION=Kyiv · UA
LOCATION_COUNTRY=UA
LOCATION_TIMEZONE=Europe/Kyiv
LOCATION_LAT=50.4501
LOCATION_LON=30.5234

# Open-Meteo upstream behavior
OPEN_METEO_TIMEOUT_MS=8000
OPEN_METEO_RETRIES=1
OPEN_METEO_RETRY_BACKOFF_MS=100
OPEN_METEO_WEATHER_TTL_MS=900000
OPEN_METEO_STALE_FALLBACK_MS=7200000

# Google Calendar — required for /v1/events.
# For private calendars, configure OAuth with calendar.readonly scope.
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=

# For public calendars only, you may use an API key instead of OAuth.
GOOGLE_CALENDAR_API_KEY=
GOOGLE_CALENDAR_TIMEOUT_MS=8000
GOOGLE_CALENDAR_TTL_MS=300000
GOOGLE_CALENDAR_STALE_FALLBACK_MS=3600000
GOOGLE_CALENDAR_MAX_RESULTS=10

# AirGradient observability backend
AIRGRADIENT_API_BASE_URL=http://localhost:8080/api/
AIRGRADIENT_TIMEOUT_MS=8000
AIRGRADIENT_TTL_MS=10000
AIRGRADIENT_RANGE_TTL_MS=30000
AIRGRADIENT_STALE_FALLBACK_MS=300000
AIRGRADIENT_RANGE_WINDOW=12h
AIRGRADIENT_RANGE_STEP=15m

# Status endpoint dependency probe timeout
STATUS_CHECK_TIMEOUT_MS=3000
